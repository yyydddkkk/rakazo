NODE_ENV=development
# Compose Postgres role (source-checkout and images stacks). Generate with:
#   openssl rand -hex 16
# Use a URI-safe value (hex from openssl is fine). Special characters such as
# @ : / ? # % break DATABASE_URL interpolation inside Compose.
# Put the same value in DATABASE_URL when using the optional host publish overlay.
# Existing pgdata volumes keep user/password/db from first init; keep those
# values in .env, or ALTER ROLE / rename in place. Recreate the volume only
# after a backup (or when disposable); down -v deletes all Postgres state.
POSTGRES_USER=rakazo
POSTGRES_PASSWORD=
POSTGRES_DB=rakazo
# The app's own login (rakazo_app): no superuser, no schema changes, and subject
# to row-level security. `pnpm db:migrate` creates it with this password.
# Generate with: openssl rand -hex 16
POSTGRES_APP_PASSWORD=
# Optional host-publish overlay port. Keep the DATABASE_*_URL ports in sync.
POSTGRES_HOST_PORT=5433
# Host-side clients only (pnpm db:migrate / pnpm dev). Requires the postgres-host
# overlay so 127.0.0.1:5433 is published. Inside Compose, api/worker ignore these
# and connect to the postgres service with POSTGRES_* above.
# The app connects as the runtime login; migrations run as the owner.
DATABASE_URL=postgres://rakazo_app:REPLACE_WITH_POSTGRES_APP_PASSWORD@127.0.0.1:5433/rakazo
DATABASE_MIGRATION_URL=postgres://rakazo:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5433/rakazo
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
# Local loopback: localhost and 127.0.0.1 are interchangeable browser hosts.
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
# Listener address. Keep loopback unless a container or trusted reverse proxy must reach the API.
API_HOST=127.0.0.1
# Reverse proxies whose forwarded client address the API believes: IPs, CIDR ranges, or hostnames.
# Empty trusts loopback; in a container, also the networks it is attached to (local-networks).
# none trusts no proxy.
TRUSTED_PROXIES=
# The header those proxies set. Default x-forwarded-for.
CLIENT_IP_HEADER=
WEB_ORIGIN=http://127.0.0.1:5173
# Optional https:// origins added to the web Content-Security-Policy, space-separated, for a
# script your CDN injects (for example analytics). See docs/self-host.md#content-security-policy.
# RAKAZO_CSP_SCRIPT_SRC=https://static.example.com
# RAKAZO_CSP_CONNECT_SRC=https://beacon.example.com
# Optional: refuse clients built before these UTC times (YYYYMMDDHHMMSS) so they update.
# See docs/self-host.md#client-updates.
# RAKAZO_MIN_CLIENT_BUILD=web=20261022093015
RAKAZO_ADMIN_EMAIL=admin@example.invalid
RAKAZO_ADMIN_PASSWORD=replace-with-a-strong-password
# Opt-in: reject new passwords found in Have I Been Pwned (sends a 5-character hash prefix).
AUTH_BREACHED_PASSWORD_CHECK_ENABLED=false
ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Optional content master keys, active first: id:key,older-id:key. See docs/content-encryption.md.
ENCRYPTION_MASTER_KEYS=
# on|off: encrypt new content at rest. Empty is off in development and on elsewhere.
CONTENT_ENCRYPTION=
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Dedicated credentials (distinct from BETTER_AUTH_SECRET). Required for Docker sandboxes /
# screen proxy outside local development.
SANDBOX_SUPERVISOR_TOKEN=replace-with-32-plus-character-supervisor-token
# Per-bot-computer ceilings. Defaults 2g / 2 CPUs / 2048 pids; "0", "none" or "unlimited" removes
# one. Memory also caps swap, and must be at least 6m (Docker's own minimum).
RAKAZO_COMPUTER_MEMORY=
RAKAZO_COMPUTER_CPUS=
RAKAZO_COMPUTER_PIDS_LIMIT=
SCREEN_PROXY_SECRET=replace-with-32-plus-character-screen-proxy-secret
SANDBOX_PROVIDER=docker
# none | emulator | cursor. Live agents require a key and an explicitly authorized Space.
CLOUD_AGENT_PROVIDER=none
CURSOR_API_KEY=
# Grant this Space access to the repositories connected to the Cursor credential.
CLOUD_AGENT_SPACE_ID=
# Optional Docker daemon socket. Defaults to /var/run/docker.sock (Unix) or
# //./pipe/docker_engine (Windows). Set for rootless Docker, Colima, or custom paths.
# DOCKER_HOST takes precedence over DOCKER_SOCKET when both are set.
# DOCKER_SOCKET=
# Enable for a host-run supervisor using a local Docker Desktop daemon: control
# uses a random token-guarded 127.0.0.1 port because container IPs are unreachable.
# Leave unset for Compose, remote Docker daemons, or native Linux Docker Engine.
# Changing this setting replaces incompatible computers on their next provision;
# their mounted homes are preserved.
# SANDBOX_CONTROL_VIA_LOOPBACK=true
AGENT_RUNTIME=pi
# Opt-in Pi JSONL session recording under DATA_DIR/pi-sessions. Default off:
# transcripts are unencrypted on disk and unsuitable for multi-tenant hosted DATA_DIR.
# PI_SESSION_RECORDING=true
# Optional ticket board; enable on both API and worker.
TICKET_BOARD_ENABLED=false
# Per-file chat/computer upload limit in MiB (positive integer; default 10).
MAX_UPLOAD_SIZE_MB=10
WAKEUP_DRIVER=graphile
# Keep app-owned PostgreSQL pools bounded. Leave DB_POOL_MAX unset so each
# process keeps its default (api 4, worker 8). A set value applies to both —
# size it for the worker (concurrency + LISTEN + leadership + Prisma headroom).
# DB_POOL_MAX=8
GRAPHILE_WORKER_CONCURRENCY=4
# Model stream retries: integer 0-5; default 1. Invalid or blank values use 1.
# More retries allow longer turns during transient provider failures.
MODEL_STREAM_MAX_RETRIES=1
# Characters a message_user progress update may carry before it is cut off: positive
# integer; default 500. Mid-turn narration keeps the 500 cap.
# RAKAZO_MESSAGE_USER_MAX_CHARS=500
# Bot-to-bot messages one chain may carry before the next is refused: positive integer;
# default 6. A person's own message starts a fresh chain.
# BOT_MESSAGE_MAX_HOPS=6
# Pause or stop computers after this many idle ms. Minimum 30000; 0 disables idle sleep.
# Set 0 when self-hosting with Docker, where an idle computer costs nothing, to keep long-running apps and sessions up.
SANDBOX_IDLE_MS=600000
# Maximum uptime on providers that bill while running. Minimum 60000; 0 disables the cap.
COMPUTER_MAX_ACTIVE_MS=7200000
# Comma-separated model ids on centrally managed local / openai-compatible endpoints that accept images.
# User-connected OpenAI-compatible models use the per-connection Supports images setting instead.
# Declared ids get input ["text","image"] so screenshot computer tools stay available.
RAKAZO_LOCAL_VISION_MODELS=
RAKAZO_OPENAI_COMPATIBLE_VISION_MODELS=
SANDBOX_COMMAND_TIMEOUT_MS=300000
# Optional limit on active bot desktops per Docker Team Computer.
# 0 leaves capacity to the machine; desktops and Chrome start only when needed.
SANDBOX_TEAM_SCREEN_LIMIT=0
# Optional cap on Computer records still backing live bots, per user. Each record
# becomes a sandbox container once provisioned, so the cap bounds the containers
# one user can create. 0 means no configured cap (default).
SANDBOX_MAX_COMPUTERS_PER_USER=0
# Optional limit on total concurrent bot computer containers per space in Docker sandboxes.
# 0 (or unset) means unlimited. Set a positive integer to cap containers per space.
SANDBOX_MAX_COMPUTERS_PER_SPACE=0
# Docker sandboxes only. "restricted" keeps computer egress to the public internet only
# (blocks the host, LAN/RFC1918, and cloud metadata endpoints) and needs
# infra/compose/restrict-computer-egress.sh run once on the Docker host; computers refuse
# to start until it has. Compose defaults to restricted. A host-run supervisor (pnpm dev,
# usually Docker Desktop, which cannot take the rules) defaults to open. See docs/self-host.md.
# SANDBOX_COMPUTER_EGRESS=open
# Docker sandboxes only. Comma-separated DNS server IPs for bot computers, instead of the
# host's resolvers. Set it with restricted egress when the host's resolver has a private
# address (a cloud VPC or LAN resolver), which the ruleset blocks. See docs/self-host.md.
# SANDBOX_COMPUTER_DNS=1.1.1.1,1.0.0.1
# Optional per-turn tool-call fuse for the Pi agent runtime. Unset, empty, or 0
# means unlimited (default). Set a positive integer to soft-stop a turn that
# exceeds the budget and still emit a final assistant message.
MAX_TOOL_CALLS_PER_TURN=
# Deployment-wide fallback model. PI_DEFAULT_PROVIDER picks which key below is used.
# A provider that authenticates from the host (amazon-bedrock with an ECS task, IRSA or EC2
# instance role, and AWS_REGION) needs no key: set PI_DEFAULT_CREDENTIALS=host, plus
# PI_DEFAULT_PROVIDER and PI_DEFAULT_MODEL. Runs then use and are billed to those credentials.
# PI_DEFAULT_CREDENTIALS=host
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
PI_DEFAULT_PROVIDER=openrouter
# Vision-capable default for chat and computer screenshots.
# Computer-use tests can override this with COMPUTER_E2E_MODEL.
PI_DEFAULT_MODEL=openai/gpt-6-luna
# Optional Auto Review verifier. Default is the deployment or user LLM (no extra key).
# Set to jev to use TypeSafe Jev over HTTP instead of the LLM checker.
# RAKAZO_AUTO_REVIEW_PROVIDER=jev
# TYPESAFE_API_KEY=
# Optional Jev model (default jev-latest) and minimum choice confidence (0-1, default 0.5).
# Below the confidence floor, Auto Review asks the user.
# RAKAZO_AUTO_REVIEW_MODEL=jev-latest
# RAKAZO_AUTO_REVIEW_MIN_CONFIDENCE=0.5
# Optional local OpenAI-compatible models. Leave blank to disable the provider.
RAKAZO_LOCAL_MODELS=
RAKAZO_LOCAL_MODELS_URL=http://127.0.0.1:11434/v1
RAKAZO_LOCAL_CONTEXT_WINDOW=32768
RAKAZO_LOCAL_MAX_TOKENS=4096
# Allow user-connected OpenAI-compatible endpoints on public hostnames (default: off).
RAKAZO_OPENAI_COMPAT_ALLOW_PUBLIC=
# Comma-separated exact model hostnames allowed to resolve only to private addresses.
# No URLs or wildcards; metadata and link-local addresses remain blocked.
RAKAZO_OPENAI_COMPAT_PRIVATE_HOSTS=
# Set to 1 to let bot credentials (request_secret) target plain-HTTP origins on
# private LAN hosts (10.x, 172.16-31.x, 192.168.x, 100.64-127.x, *.local, loopback).
RAKAZO_SECRETS_ALLOW_PRIVATE_HTTP=
# Allow remote MCP, API connectors, and OpenAI-compatible model servers
# on loopback / RFC1918 / Docker-network hosts for every user.
# The deployment owner always has this. Leave unset on public installs.
MCP_ALLOW_PRIVATE_ENDPOINT=
# Stdio MCP servers (off unless MCP_STDIO_ENABLED=true and the command is allowlisted).
MCP_STDIO_ENABLED=
# Comma-separated exact commands, for example: npx,uvx
MCP_STDIO_ALLOWED_COMMANDS=
# `npx <package>` servers are installed once here, shared by the API and worker.
# Default: DATA_DIR/mcp-packages (or /data/mcp-packages), else the OS temp dir.
MCP_PACKAGES_DIR=
# Install timeout (default 180000), handshake timeout after launch (default 30000), and how
# long an unused server process keeps running (default 900000; 0 keeps it until shutdown).
MCP_STDIO_INSTALL_TIMEOUT_MS=
MCP_STDIO_STARTUP_TIMEOUT_MS=
MCP_STDIO_IDLE_MS=
# How long a run waits for one MCP server's tool list before going on without it (default 20000).
MCP_DISCOVERY_TIMEOUT_MS=
# Optional integrations.sh-compatible catalog base URL (Rakazo appends api/search).
# Example: https://integrations.sh/ or a self-hosted mirror base, not the full search endpoint.
INTEGRATIONS_CATALOG_URL=
# Optional provider-neutral external conversation engine.
EXTERNAL_CONVERSATION_BOT_ID=
# Optional separate judge model for ambient room replies (both or neither):
EXTERNAL_CONVERSATION_JUDGE_PROVIDER=
EXTERNAL_CONVERSATION_JUDGE_MODEL=
# Feishu/Lark (app id, secret, and verification token required). Inbound is
# webhook-only at /api/v1/messaging/webhook/lark — do not enable long
# connection in the developer console or the HTTP webhook will miss events.
# Create a custom app with the Bot capability, subscribe to im.message.receive_v1,
# and set the event subscription URL to that path. LARK_DOMAIN=feishu uses
# open.feishu.cn (default); lark uses open.larksuite.com. Encrypt key is
# optional unless event encryption is enabled in the console.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_DOMAIN=
# Transactional account email. Works with Resend, Amazon SES, or any SMTP server.
SMTP_URL=
EMAIL_FROM=
# Local development only: capture password-reset email and print its link to the API console.
EMAIL_EMULATOR=
# Structured logs to stdout (json in production, pretty in development unless overridden).
LOG_LEVEL=info
LOG_FORMAT=
# Optional. GET /internal/health on the API port returns this as `revision` so you can confirm the deployed commit.
GIT_SHA=

# Checkout path used by the optional host backup and deployment scripts.
RAKAZO_DEPLOY_DIR=
# Published images (defaults match this repository). Tag `local` is built from the checkout.
RAKAZO_IMAGE=ghcr.io/elie222/rakazo/app
RAKAZO_IMAGE_TAG=local

# Optional default UI locale for the web SPA (en | zh-CN).
# Overridden by localStorage key rakazo.uiLocale when the user picks a language in Settings.
# VITE_DEFAULT_UI_LOCALE=en
# Optional bot media generation. Models must be explicitly enabled.
MEDIA_GENERATION_PROVIDER=disabled
MEDIA_GENERATION_BASE_URL=https://queue.fal.run
MEDIA_GENERATION_API_KEY=
MEDIA_GENERATION_IMAGE_MODEL=
MEDIA_GENERATION_VIDEO_MODEL=
