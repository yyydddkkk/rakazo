{
  "name": "rakazo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "cross-env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 turbo dev --env-mode=loose --filter=@rakazo/api --filter=@rakazo/worker --filter=@rakazo/web --filter=@rakazo/sandbox-supervisor",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @rakazo/db generate",
    "db:migrate": "pnpm --filter @rakazo/api db:migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer",
    "test": "vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/pi-offline.test.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "proxy-addr@<2.0.8": "2.0.8"
    }
  }
}
